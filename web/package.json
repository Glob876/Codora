{
  "name": "typoha-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src index.html package.json tsconfig.json",
    "format:check": "prettier --check src index.html package.json tsconfig.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.3.0",
    "highlight.js": "11.12.0",
    "html-to-image": "^1.11.13",
    "katex": "0.19.0",
    "marked": "^17.0.0",
    "marked-alert": "2.1.2",
    "marked-footnote": "1.4.0",
    "mermaid": "11.17.2",
    "node-emoji": "2.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
